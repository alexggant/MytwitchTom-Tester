{
  "manifest_version": 3,
  "name": "Twitch Space",
  "version": "2.3.0",
  "description": "Upgrades for watching Twitch: player, emotes, chat, watch streaks, VOD markers and split screen.",
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "settings.js",
        "content.js",
        "pins.js",
        "freqchannels.js",
        "streak.js",
        "vodmarks.js",
        "knob.js",
        "people.js",
        "myname.js",
        "rewardsearch.js",
        "streaksaver.js",
        "phrases.js",
        "accounts.js",
        "claim.js",
        "splitview.js",
        "pinchannels.js",
        "askstreamer.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://www.twitch.tv/embed/*",
        "https://player.twitch.tv/*"
      ]
    },
    {
      "matches": [
        "https://www.twitch.tv/embed/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "settings.js",
        "content.js",
        "pins.js",
        "freqchannels.js",
        "streak.js",
        "people.js",
        "myname.js",
        "rewardsearch.js",
        "phrases.js",
        "claim.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://player.twitch.tv/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://player.twitch.tv/*",
        "https://www.twitch.tv/embed/*"
      ],
      "js": [
        "splitframes.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "cookies"
  ],
  "action": {
    "default_popup": "switches.html",
    "default_title": "Twitch Space",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://*.twitch.tv/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png"
      ],
      "matches": [
        "*://*.twitch.tv/*"
      ]
    }
  ]
}
